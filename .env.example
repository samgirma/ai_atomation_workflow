# ==============================================================================
# AI Research Automation Pipeline - Environment Configuration Template
# Copy this file to .env before starting n8n if passing configuration via environment.
# Note: You can also configure credentials directly via the n8n UI Credential Manager.
# ==============================================================================

# Google Gemini API Key (obtained from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=replace_me_with_gemini_api_key

# Pinecone Vector Database Credentials (https://app.pinecone.io/)
PINECONE_API_KEY=replace_me_with_pinecone_api_key
PINECONE_INDEX_NAME=research-pipeline-index
PINECONE_INDEX_HOST=research-pipeline-index-xxxxxxx.svc.pinecone.io
PINECONE_MIN_RELEVANCE=0.65

# Digest & Notification Delivery
GMAIL_RECIPIENT=researcher@example.com

# Pipeline Defaults
DEFAULT_RESEARCH_TOPIC=quantum computing
N8N_BASE_URL=http://localhost:5678
